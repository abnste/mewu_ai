<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MewuAI.ico</ApplicationIcon>
    <AssemblyName>MewuAI</AssemblyName>
    <RootNamespace>mewu_ai_Assistant</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MewuAI.Icon.png" />
    <Content Include="Assets\MewuAI.ico" Link="MewuAI.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
