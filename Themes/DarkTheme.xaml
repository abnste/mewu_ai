<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#0B1018"/><SolidColorBrush x:Key="PanelBackground" Color="#121A26"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#F3F7FF"/><SolidColorBrush x:Key="SecondaryText" Color="#91A0B5"/><SolidColorBrush x:Key="Accent" Color="#318CFF"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBackground}"/><Setter Property="BorderBrush" Value="#263246"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="28"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="22,11"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#202B3A"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/></Style>
</ResourceDictionary>
