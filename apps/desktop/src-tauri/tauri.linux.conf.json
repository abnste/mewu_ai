{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false,
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "usr/lib/libGLESv2.so.2": "/usr/lib/x86_64-linux-gnu/libGLESv2.so.2",
          "usr/share/doc/libgles2/copyright": "/usr/share/doc/libgles2/copyright"
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "space",
        "title": "Mewu 1.0",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#00000000",
        "dragDropEnabled": false,
        "resizable": false,
        "fullscreen": false,
        "transparent": true
      }
    ]
  }
}
