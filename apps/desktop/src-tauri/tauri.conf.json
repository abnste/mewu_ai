{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MewuAI",
  "version": "1.0.0-preview.1",
  "identifier": "dev.mewu.remake",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "space",
        "title": "Mewu 1.0",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#00000000",
        "dragDropEnabled": false,
        "resizable": false,
        "fullscreen": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:0 blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src http://127.0.0.1:0; frame-src http://127.0.0.1:0; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": [
          "$APPDATA/assets/**"
        ]
      },
      "capabilities": [
        "space",
        "frozen-widget",
        "recording-controls",
        "scroll-controls",
        "settings",
        "pin"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "license": "MPL-2.0",
    "shortDescription": "Mewu AI desktop",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "mainBinaryName": "MewuAI",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyQkRGNDMyOUNEMDYwOTEKUldTUllOQ2NNdlM5QWl0a2NpMER5cURVNkk0Y2NIS3h1WkZ4WXZnT0NBYyszaDdQa05ZRVI2dlQK",
      "endpoints": [
        "https://github.com/abnste/mewu_ai/releases/download/update-channel/preview.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
