    "allow-discover-mcp-server",
    "allow-runtime-info",
    "allow-memory-page",
    "allow-memory-entry",
    "allow-get-plugins",
    "allow-get-plugin-catalog",
    "allow-prepare-plugin",
    "allow-install-plugin",
    "allow-set-plugin-enabled",
    "allow-uninstall-plugin",
    "allow-rollback-plugin",
    "allow-reinstall-official-plugin",
    "allow-prepare-plugin-update",
    "allow-get-provider-presets",
    "allow-save-connection-profile",
    "allow-delete-connection-profile",
    "allow-discover-connection-models",
    "allow-test-connection",
    "allow-cancel-connection-probe",
    "allow-get-memory-provider-state",
