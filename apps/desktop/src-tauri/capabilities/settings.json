    "allow-read-license-document",
    "allow-get-recording-audio",
    "allow-set-recording-audio",
    "allow-get-data-directory-state",
    "allow-choose-data-directory",
    "allow-cancel-data-directory-proposal",
    "allow-migrate-data-directory",
    "allow-set-ui-language",
