{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "frozen-widget",
  "description": "First-party frozen-scene summary, close, hide and explicit restore",
  "windows": [
    "frozen-widget"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-frozen-scenes",
    "allow-restore-frozen-scene",
    "allow-resize-frozen-widget",
    "allow-close-scene-window",
    "allow-hide-frozen-widget"
  ]
}
