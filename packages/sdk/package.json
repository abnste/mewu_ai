{
  "name": "@mewu/sdk",
  "version": "0.1.0",
  "description": "Mewu API 2 executable extension SDK",
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": ["index.mjs", "index.d.ts", "README.md", "LICENSE"],
