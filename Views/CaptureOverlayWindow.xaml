  <Style x:Key="ReferenceChipRemoveButton" TargetType="Button"><Setter Property="Foreground" Value="#7E8BA0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ChipClose" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipClose" Property="Background" Value="#F8DFE3"/><Setter Property="Foreground" Value="#C64E5B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextSelectionContextMenu" TargetType="ContextMenu"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#FCFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="12" Padding="6"><Border.Effect><DropShadowEffect Color="#334762" BlurRadius="22" ShadowDepth="5" Opacity="0.22"/></Border.Effect><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextSelectionMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#34435A"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinWidth" Value="178"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#EAF1FA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextSelectionSeparator" TargetType="Separator"><Setter Property="Height" Value="1"/><Setter Property="Margin" Value="8,5"/><Setter Property="Background" Value="#E3E9F1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}" Height="1"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AnswerTextBox" TargetType="TextBox"><Setter Property="Foreground" Value="#26344A"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="IsReadOnlyCaretVisible" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Canvas x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" LostMouseCapture="OnLostMouseCapture">
  <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False"/>
  <Rectangle x:Name="Dimmer" Fill="#99000000" IsHitTestVisible="False"/>
  <Canvas x:Name="SelectionLayer" IsHitTestVisible="True"/>
  <p:Thumb x:Name="Nw" Tag="NW" Cursor="SizeNWSE" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/><p:Thumb x:Name="N" Tag="N" Cursor="SizeNS" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/><p:Thumb x:Name="Ne" Tag="NE" Cursor="SizeNESW" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/>
  <p:Thumb x:Name="W" Tag="W" Cursor="SizeWE" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/><p:Thumb x:Name="E" Tag="E" Cursor="SizeWE" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/>
  <p:Thumb x:Name="Sw" Tag="SW" Cursor="SizeNESW" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/><p:Thumb x:Name="S" Tag="S" Cursor="SizeNS" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/><p:Thumb x:Name="Se" Tag="SE" Cursor="SizeNWSE" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted" Visibility="Collapsed"/>
  <Border x:Name="Toolbar" Visibility="Collapsed" Background="#FAFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="18" Padding="6">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <WrapPanel x:Name="ToolbarItems" Orientation="Horizontal">
    <Button x:Name="ReferenceButton" ToolTip="引用当前区域到对话" AutomationProperties.Name="引用当前区域" Click="ReferenceRegion" Style="{StaticResource ReferenceIconButton}"><TextBlock Text="@" FontSize="18" FontWeight="Bold"/></Button>
    <Button ToolTip="添加区域；Shift+拖动可新增重叠区域" AutomationProperties.Name="添加截图区域" Click="AddRegion" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,1 L9,17 M1,9 L17,9"/></Button>
    <Button ToolTip="删除当前区域 (Delete)" AutomationProperties.Name="删除当前区域" Click="RemoveSelection" Style="{StaticResource ToolbarIconButton}"><Path Width="17" Height="18" Stroke="#D75B68" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M3,5 L15,5 M6,5 L6,3 L12,3 L12,5 M5,7 L6,17 L12,17 L13,7 M8,8 L8,14 M10,8 L10,14"/></Button>
    <Border Width="1" Background="#E2E8F1" Margin="5,6"/>
     <Button x:Name="TranslateButton" ToolTip="原位翻译 (T)" AutomationProperties.Name="原位翻译" Click="Translate" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,3 L10,3 L10,9 L6,9 L3,12 L3,9 L2,9 Z M8,7 L16,7 L16,13 L13,13 L13,16 L10,13 L8,13 Z"/></Button>
     <Button x:Name="OcrButton" ToolTip="原位文字识别 (O)" AutomationProperties.Name="原位文字识别" Click="Ocr" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="#52637A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,6 L2,2 L6,2 M12,2 L16,2 L16,6 M16,12 L16,16 L12,16 M6,16 L2,16 L2,12 M5,7 L13,7 M5,10 L13,10 M5,13 L11,13"/></Button>
    <Button x:Name="PinButton" ToolTip="贴图 (P)" AutomationProperties.Name="原位贴图或贴视频" Click="Pin" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M6,2 L14,2 L12,7 L16,11 L10.5,11 L10,17 L8.5,11 L3,11 L7,7 Z"/></Button>
    <Button x:Name="DrawButton" ToolTip="原位标注 (D)" AutomationProperties.Name="原位标注" Click="Draw" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M3,14 L3,17 L6,17 L16,7 L13,4 Z M11.5,5.5 L14.5,8.5"/></Button>
    <Button x:Name="VideoPlayButton" Visibility="Collapsed" ToolTip="播放 / 暂停视频" AutomationProperties.Name="播放或暂停视频" Click="ToggleVideoPlayback" Style="{StaticResource ToolbarIconButton}"><Path Width="17" Height="18" Fill="#52637A" Data="M4,2 L16,9 L4,16 Z"/></Button>
    <Button x:Name="CopyButton" ToolTip="复制 (C)" AutomationProperties.Name="复制当前区域" Click="Copy" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M6,6 L16,6 L16,16 L6,16 Z M3,12 L3,3 L12,3"/></Button>
    <Button x:Name="SaveButton" ToolTip="保存 (S)" AutomationProperties.Name="保存当前区域" Click="Save" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M3,2 L14,2 L17,5 L17,17 L3,17 Z M6,2 L6,7 L13,7 L13,2 M6,17 L6,11 L14,11 L14,17"/></Button>
    <Button x:Name="RecordButton" ToolTip="区域录屏 (R)" AutomationProperties.Name="录制当前区域" Click="Record" Style="{StaticResource ToolbarIconButton}"><Grid><Ellipse Width="17" Height="17" Stroke="#52637A" StrokeThickness="1.7"/><Ellipse Width="7" Height="7" Fill="#E05A67"/></Grid></Button>
   </WrapPanel>
  </Border>
  <Border x:Name="DrawingToolbar" Visibility="Collapsed" Background="#FAFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="18" Padding="6">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <WrapPanel x:Name="DrawingToolbarItems" Orientation="Horizontal">
    <Button ToolTip="画笔" AutomationProperties.Name="画笔工具" Click="DrawPen" Style="{StaticResource ReferenceIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,15 L3,18 L6,18 L16,8 L13,5 Z M11.5,6.5 L14.5,9.5"/></Button>
    <Button ToolTip="矩形" AutomationProperties.Name="矩形标注工具" Click="DrawRectangleTool" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M3,3 L17,3 L17,17 L3,17 Z"/></Button>
    <Button ToolTip="箭头" AutomationProperties.Name="箭头标注工具" Click="DrawArrowTool" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,15 L15,3 M9,3 L15,3 L15,9"/></Button>
    <Button ToolTip="红色" AutomationProperties.Name="使用红色标注" Click="DrawRed" Style="{StaticResource ToolbarIconButton}"><Ellipse Width="11" Height="11" Fill="#E14959"/></Button>
    <Button ToolTip="蓝色" AutomationProperties.Name="使用蓝色标注" Click="DrawBlue" Style="{StaticResource ToolbarIconButton}"><Ellipse Width="11" Height="11" Fill="#318CFF"/></Button>
    <Button ToolTip="高亮" AutomationProperties.Name="高亮标注工具" Click="DrawHighlight" Style="{StaticResource ToolbarIconButton}"><Rectangle Width="12" Height="12" RadiusX="3" Fill="#EAB631"/></Button>
    <Button ToolTip="橡皮" AutomationProperties.Name="橡皮擦工具" Click="DrawEraser" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,13 L10,4 L17,11 L11,17 L4,17 L2,15 Z M8,15 L14,9"/></Button>
    <Border Width="1" Background="#E2E8F1" Margin="5,6"/>
    <Button ToolTip="撤销" AutomationProperties.Name="撤销标注" Click="DrawUndo" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8,4 L3,9 L8,14 M4,9 L12,9 C15,9 17,11 17,14"/></Button>
    <Button ToolTip="重做" AutomationProperties.Name="重做标注" Click="DrawRedo" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12,4 L17,9 L12,14 M16,9 L8,9 C5,9 3,11 3,14"/></Button>
    <Button ToolTip="清空标注" AutomationProperties.Name="清空全部标注" Click="DrawClear" Style="{StaticResource ToolbarIconButton}"><Path Width="17" Height="18" Stretch="Uniform" Stroke="#D75B68" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,5 L15,5 M6,5 L6,3 L12,3 L12,5 M5,7 L6,17 L12,17 L13,7 M8,9 L8,14 M10,9 L10,14"/></Button>
    <Button ToolTip="完成标注" AutomationProperties.Name="完成标注" Click="DrawDone" Style="{StaticResource ReferenceIconButton}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,10 L8,14 L16,5"/></Button>
   </WrapPanel>
  </Border>
  <Border x:Name="RecordingBar" Visibility="Collapsed" Background="#FCFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="18" Padding="10,7">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <StackPanel Orientation="Horizontal">
    <Ellipse Width="9" Height="9" Fill="#EE4E5C" Margin="4,0,8,0"/>
    <TextBlock Text="录制中" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="RecordingTime" Text="00:00" Foreground="#637089" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,10,0"/>
    <Button x:Name="RecordingPauseButton" ToolTip="暂停" AutomationProperties.Name="暂停或继续录屏" Click="PauseRecording" Style="{StaticResource ToolbarIconButton}"><Grid Width="18" Height="18"><StackPanel x:Name="RecordingPauseBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="4" Height="13" RadiusX="1" RadiusY="1" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><Rectangle Width="4" Height="13" RadiusX="1" RadiusY="1" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="4,0,0,0"/></StackPanel><Path x:Name="RecordingResumeIcon" Visibility="Collapsed" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Data="M4,2 L15,8.5 L4,15 Z"/></Grid></Button>
    <Button ToolTip="停止并原位预览" AutomationProperties.Name="停止录屏并原位预览" Click="StopRecording" Style="{StaticResource ToolbarIconButton}"><Rectangle Width="12" Height="12" RadiusX="2" Fill="#DA4856"/></Button>
   </StackPanel>
  </Border>
   <Border x:Name="PromptBar" Background="#FAFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="20" Padding="7" Opacity="0.99" ClipToBounds="True">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
    <Grid x:Name="PromptContent">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ResponseScroll" Grid.Row="0" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <StackPanel x:Name="AnswerHeader" Orientation="Horizontal" Visibility="Collapsed" Margin="8,3,8,0"><Path Width="17" Height="17" Stretch="Uniform" Fill="#6172EF" Data="M8.5,0 L10.4,6.6 L17,8.5 L10.4,10.4 L8.5,17 L6.6,10.4 L0,8.5 L6.6,6.6 Z"/><TextBlock Text="AI 回答" Foreground="#243148" FontSize="14" FontWeight="SemiBold" Margin="8,1,0,0"/></StackPanel>
      <Button x:Name="ReasoningToggle" Visibility="Collapsed" Style="{StaticResource ReasoningButton}" Click="ToggleReasoning"><StackPanel Orientation="Horizontal"><Border x:Name="ReasoningPulse" Width="7" Height="7" CornerRadius="4" Background="#7B8AF4" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="ReasoningLabel" Text="正在思考…" FontSize="12.5"/><Path x:Name="ReasoningChevron" Width="12" Height="12" Stretch="Uniform" Stroke="#617188" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="8,0,0,0" Data="M2,4 L6,8 L10,4" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="ReasoningChevronRotation" Angle="180"/></Path.RenderTransform></Path></StackPanel></Button>
      <Border x:Name="ReasoningPanel" Visibility="Collapsed" Background="#F3F6FA" BorderBrush="#DFE7F1" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="6,6,6,0"><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReasoningText" Foreground="#65748A" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/></ScrollViewer></Border>
      <ScrollViewer x:Name="AnswerScroll" Visibility="Collapsed" MaxHeight="188" VerticalScrollBarVisibility="Auto" Margin="8,8,8,8"><TextBox x:Name="AnswerText" Style="{StaticResource AnswerTextBox}"/></ScrollViewer>
      <Border x:Name="AnswerDivider" Visibility="Collapsed" Height="1" Background="#E1E7F0" Margin="8,0,8,8"/>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Background="#F4F7FB" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="13" Padding="3,2">
