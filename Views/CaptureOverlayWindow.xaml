<Window x:Class="mewu_ai_Assistant.Views.CaptureOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="喵呜AI 屏幕助手" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Cursor="Cross" KeyDown="OnKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F3F7FF"/><Setter Property="Background" Value="#202B3A"/><Setter Property="BorderBrush" Value="#31435B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#315B86"/><Setter TargetName="B" Property="BorderBrush" Value="#43A8FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Canvas x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
  <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False"/>
  <Rectangle x:Name="Dimmer" Fill="#99000000" IsHitTestVisible="False"/>
  <Image x:Name="SelectedImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Border x:Name="SelectionBorder" BorderBrush="#43A8FF" BorderThickness="2" Background="Transparent" Visibility="Collapsed" Cursor="SizeAll"/>
  <p:Thumb x:Name="Nw" Tag="NW" Cursor="SizeNWSE" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="N" Tag="N" Cursor="SizeNS" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="Ne" Tag="NE" Cursor="SizeNESW" DragDelta="ResizeDelta" Visibility="Collapsed"/>
  <p:Thumb x:Name="W" Tag="W" Cursor="SizeWE" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="E" Tag="E" Cursor="SizeWE" DragDelta="ResizeDelta" Visibility="Collapsed"/>
  <p:Thumb x:Name="Sw" Tag="SW" Cursor="SizeNESW" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="S" Tag="S" Cursor="SizeNS" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="Se" Tag="SE" Cursor="SizeNWSE" DragDelta="ResizeDelta" Visibility="Collapsed"/>
  <Border x:Name="Toolbar" Visibility="Collapsed" Background="#F2131B27" BorderBrush="#526783" BorderThickness="1" CornerRadius="10" Padding="6">
   <StackPanel Orientation="Horizontal">
    <Button Content="✦ AI 助手" ToolTip="分析当前选区 (Enter)" Click="AskAi" Background="#2F7FE8" BorderBrush="#4BAEFF"/><Button Content="翻译" ToolTip="原位翻译 (T)" Click="Translate"/><Button Content="文字" ToolTip="文字识别 (O)" Click="Ocr"/>
    <Button Content="贴图" ToolTip="贴图 (P)" Click="Pin"/><Button Content="标注" ToolTip="标注 (D)" Click="Draw"/><Button Content="复制" ToolTip="复制 (C)" Click="Copy"/><Button Content="保存" ToolTip="保存 (S)" Click="Save"/><Button Content="录屏" ToolTip="区域录屏 (R)" Click="Record"/>
   </StackPanel>
  </Border>
  <Border x:Name="PromptBar" Background="#F20A1525" BorderBrush="#704BAEFF" BorderThickness="1" CornerRadius="15" Padding="9" Opacity="0.98">
   <Border.Effect><DropShadowEffect Color="#020814" BlurRadius="24" ShadowDepth="7" Opacity="0.75"/></Border.Effect>
   <Grid Width="610">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid>
     <TextBox x:Name="QuickPrompt" MinHeight="44" Padding="13,10" AcceptsReturn="True" TextWrapping="Wrap" Foreground="White" CaretBrush="#43C6FF" Background="#CC101E31" BorderBrush="#526783" BorderThickness="1" PreviewKeyDown="QuickPromptKeyDown"/>
     <TextBlock x:Name="QuickPromptHint" Text="询问当前屏幕，或先圈选一个区域…" Foreground="#8494AA" Margin="14,13,0,0" IsHitTestVisible="False"/>
    </Grid>
    <Button Grid.Column="1" Content="⌁" ToolTip="语音输入" Click="QuickVoice" Padding="14,10"/>
    <Button Grid.Column="2" Content="➤" ToolTip="发送" Click="QuickSend" Background="#5266E8" BorderBrush="#6F85FF" Padding="17,10"/>
   </Grid>
  </Border>
  <TextBlock x:Name="SizeText" Visibility="Collapsed" Foreground="White" Background="#CC111722" Padding="6,3"/>
 </Canvas>
</Window>
