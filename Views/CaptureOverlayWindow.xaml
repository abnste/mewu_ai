<Window x:Class="mewu_ai_Assistant.Views.CaptureOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="喵呜AI 屏幕助手" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Cursor="Cross" KeyDown="OnKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#52637A"/><Setter Property="Background" Value="#F5F8FC"/><Setter Property="BorderBrush" Value="#D8E2EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#EAF1FA"/><Setter TargetName="B" Property="BorderBrush" Value="#B9CBE3"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RoundIconButton" TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#52637A"/><Setter Property="Background" Value="#F5F8FC"/><Setter Property="BorderBrush" Value="#D8E2EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#EAF1FA"/><Setter TargetName="Circle" Property="BorderBrush" Value="#B9CBE3"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SendRoundButton" TargetType="Button" BasedOn="{StaticResource RoundIconButton}"><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#6576F4"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6F7CF5" Offset="0"/><GradientStop Color="#5365E9" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#5365E9" BlurRadius="16" ShadowDepth="3" Opacity="0.34"/></Setter.Value></Setter></Style>
  <Style x:Key="ReasoningButton" TargetType="Button"><Setter Property="Foreground" Value="#617188"/><Setter Property="Background" Value="#EEF3F9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="6,8,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="R" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Background" Value="#E4ECF6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ToolbarIconButton" TargetType="Button"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#52637A"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ToolIcon" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolIcon" Property="Background" Value="#EAF1FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ToolIcon" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ReferenceIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}"><Setter Property="Foreground" Value="#5869E9"/><Setter Property="Background" Value="#E9EDFF"/></Style>
  <Style x:Key="ReferenceChipButton" TargetType="Button"><Setter Property="Foreground" Value="#5264DF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,3,3,3"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ChipLink" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipLink" Property="Background" Value="#DCE4FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ReferenceChipRemoveButton" TargetType="Button"><Setter Property="Foreground" Value="#7E8BA0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ChipClose" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipClose" Property="Background" Value="#F8DFE3"/><Setter Property="Foreground" Value="#C64E5B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextSelectionContextMenu" TargetType="ContextMenu"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#FCFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="12" Padding="6"><Border.Effect><DropShadowEffect Color="#334762" BlurRadius="22" ShadowDepth="5" Opacity="0.22"/></Border.Effect><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextSelectionMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#34435A"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinWidth" Value="178"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#EAF1FA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TextSelectionSeparator" TargetType="Separator"><Setter Property="Height" Value="1"/><Setter Property="Margin" Value="8,5"/><Setter Property="Background" Value="#E3E9F1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}" Height="1"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Canvas x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
  <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False"/>
  <Rectangle x:Name="Dimmer" Fill="#99000000" IsHitTestVisible="False"/>
  <Canvas x:Name="SelectionLayer" IsHitTestVisible="True"/>
  <p:Thumb x:Name="Nw" Tag="NW" Cursor="SizeNWSE" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="N" Tag="N" Cursor="SizeNS" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="Ne" Tag="NE" Cursor="SizeNESW" DragDelta="ResizeDelta" Visibility="Collapsed"/>
  <p:Thumb x:Name="W" Tag="W" Cursor="SizeWE" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="E" Tag="E" Cursor="SizeWE" DragDelta="ResizeDelta" Visibility="Collapsed"/>
  <p:Thumb x:Name="Sw" Tag="SW" Cursor="SizeNESW" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="S" Tag="S" Cursor="SizeNS" DragDelta="ResizeDelta" Visibility="Collapsed"/><p:Thumb x:Name="Se" Tag="SE" Cursor="SizeNWSE" DragDelta="ResizeDelta" Visibility="Collapsed"/>
  <Border x:Name="Toolbar" Visibility="Collapsed" Background="#FAFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="18" Padding="6">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="ReferenceButton" ToolTip="引用当前区域到对话" Click="ReferenceRegion" Style="{StaticResource ReferenceIconButton}"><TextBlock Text="@" FontSize="18" FontWeight="Bold"/></Button>
    <Button ToolTip="添加区域；Shift+拖动可新增重叠区域" Click="AddRegion" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,1 L9,17 M1,9 L17,9"/></Button>
    <Button ToolTip="删除当前区域 (Delete)" Click="RemoveSelection" Style="{StaticResource ToolbarIconButton}"><Path Width="17" Height="18" Stroke="#D75B68" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M3,5 L15,5 M6,5 L6,3 L12,3 L12,5 M5,7 L6,17 L12,17 L13,7 M8,8 L8,14 M10,8 L10,14"/></Button>
    <Border Width="1" Background="#E2E8F1" Margin="5,6"/>
    <Button ToolTip="原位翻译 (T)" Click="Translate" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="译" FontSize="16" FontWeight="SemiBold" Foreground="#52637A"/></Button>
    <Button ToolTip="原位文字识别 (O)" Click="Ocr" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="T" FontSize="17" FontWeight="Bold" Foreground="#52637A"/></Button>
    <Button x:Name="PinButton" ToolTip="贴图 (P)" Click="Pin" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M6,2 L14,2 L12,7 L16,11 L10.5,11 L10,17 L8.5,11 L3,11 L7,7 Z"/></Button>
    <Button x:Name="DrawButton" ToolTip="原位标注 (D)" Click="Draw" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M3,14 L3,17 L6,17 L16,7 L13,4 Z M11.5,5.5 L14.5,8.5"/></Button>
    <Button x:Name="VideoPlayButton" Visibility="Collapsed" ToolTip="播放 / 暂停视频" Click="ToggleVideoPlayback" Style="{StaticResource ToolbarIconButton}"><Path Width="17" Height="18" Fill="#52637A" Data="M4,2 L16,9 L4,16 Z"/></Button>
    <Button x:Name="CopyButton" ToolTip="复制 (C)" Click="Copy" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M6,6 L16,6 L16,16 L6,16 Z M3,12 L3,3 L12,3"/></Button>
    <Button x:Name="SaveButton" ToolTip="保存 (S)" Click="Save" Style="{StaticResource ToolbarIconButton}"><Path Width="18" Height="18" Stroke="#52637A" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M3,2 L14,2 L17,5 L17,17 L3,17 Z M6,2 L6,7 L13,7 L13,2 M6,17 L6,11 L14,11 L14,17"/></Button>
    <Button x:Name="RecordButton" ToolTip="区域录屏 (R)" Click="Record" Style="{StaticResource ToolbarIconButton}"><Grid><Ellipse Width="17" Height="17" Stroke="#52637A" StrokeThickness="1.7"/><Ellipse Width="7" Height="7" Fill="#E05A67"/></Grid></Button>
   </StackPanel>
  </Border>
  <Border x:Name="DrawingToolbar" Visibility="Collapsed" Background="#FAFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="18" Padding="6">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <StackPanel Orientation="Horizontal">
    <Button ToolTip="画笔" Click="DrawPen" Style="{StaticResource ReferenceIconButton}"><TextBlock Text="✎" FontSize="17"/></Button>
    <Button ToolTip="矩形" Click="DrawRectangleTool" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="□" FontSize="18"/></Button>
    <Button ToolTip="箭头" Click="DrawArrowTool" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="↗" FontSize="18"/></Button>
    <Button ToolTip="红色" Click="DrawRed" Style="{StaticResource ToolbarIconButton}"><Ellipse Width="11" Height="11" Fill="#E14959"/></Button>
    <Button ToolTip="蓝色" Click="DrawBlue" Style="{StaticResource ToolbarIconButton}"><Ellipse Width="11" Height="11" Fill="#318CFF"/></Button>
    <Button ToolTip="高亮" Click="DrawHighlight" Style="{StaticResource ToolbarIconButton}"><Rectangle Width="12" Height="12" RadiusX="3" Fill="#EAB631"/></Button>
    <Button ToolTip="橡皮" Click="DrawEraser" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="⌫" FontSize="17"/></Button>
    <Border Width="1" Background="#E2E8F1" Margin="5,6"/>
    <Button ToolTip="撤销" Click="DrawUndo" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="↶" FontSize="18"/></Button>
    <Button ToolTip="重做" Click="DrawRedo" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="↷" FontSize="18"/></Button>
    <Button ToolTip="清空标注" Click="DrawClear" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="×" FontSize="18" Foreground="#D75B68"/></Button>
    <Button ToolTip="完成标注" Click="DrawDone" Style="{StaticResource ReferenceIconButton}"><TextBlock Text="✓" FontSize="17"/></Button>
   </StackPanel>
  </Border>
  <Border x:Name="RecordingBar" Visibility="Collapsed" Background="#FCFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="18" Padding="10,7">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <StackPanel Orientation="Horizontal">
    <Ellipse Width="9" Height="9" Fill="#EE4E5C" Margin="4,0,8,0"/>
    <TextBlock Text="录制中" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="RecordingTime" Text="00:00" Foreground="#637089" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,10,0"/>
    <Button x:Name="RecordingPauseButton" ToolTip="暂停" Click="PauseRecording" Style="{StaticResource ToolbarIconButton}"><TextBlock Text="Ⅱ" FontSize="14"/></Button>
    <Button ToolTip="停止并原位预览" Click="StopRecording" Style="{StaticResource ToolbarIconButton}"><Rectangle Width="12" Height="12" RadiusX="2" Fill="#DA4856"/></Button>
   </StackPanel>
  </Border>
  <Border x:Name="PromptBar" Background="#FAFFFFFF" BorderBrush="#D7E1EF" BorderThickness="1" CornerRadius="20" Padding="7" Opacity="0.99">
   <Border.Effect><DropShadowEffect Color="#334762" BlurRadius="24" ShadowDepth="6" Opacity="0.24"/></Border.Effect>
   <Grid x:Name="PromptContent" Width="560">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="AnswerHeader" Orientation="Horizontal" Visibility="Collapsed" Margin="8,3,8,0"><TextBlock Text="✦" Foreground="#6172EF" FontSize="17"/><TextBlock Text="AI 回答" Foreground="#243148" FontSize="14" FontWeight="SemiBold" Margin="8,1,0,0"/></StackPanel>
    <Button x:Name="ReasoningToggle" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource ReasoningButton}" Click="ToggleReasoning"><StackPanel Orientation="Horizontal"><Border x:Name="ReasoningPulse" Width="7" Height="7" CornerRadius="4" Background="#7B8AF4" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="ReasoningLabel" Text="正在思考…" FontSize="12.5"/><TextBlock x:Name="ReasoningChevron" Text="⌃" FontSize="12" Margin="8,0,0,0"/></StackPanel></Button>
    <Border x:Name="ReasoningPanel" Grid.Row="2" Visibility="Collapsed" Background="#F3F6FA" BorderBrush="#DFE7F1" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="6,6,6,0"><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReasoningText" Foreground="#65748A" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/></ScrollViewer></Border>
    <ScrollViewer x:Name="AnswerScroll" Grid.Row="3" Visibility="Collapsed" MaxHeight="188" VerticalScrollBarVisibility="Auto" Margin="8,8,8,8"><TextBlock x:Name="AnswerText" TextWrapping="Wrap" LineHeight="23" Foreground="#26344A"/></ScrollViewer>
    <Border x:Name="AnswerDivider" Grid.Row="4" Visibility="Collapsed" Height="1" Background="#E1E7F0" Margin="8,0,8,8"/>
    <Grid Grid.Row="5">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Background="#F4F7FB" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="13" Padding="3,2">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel x:Name="ReferenceChips" Visibility="Collapsed" Margin="6,3,6,1"/><Grid Grid.Row="1"><TextBox x:Name="QuickPrompt" MinHeight="34" MaxHeight="72" Padding="9,5" FontSize="13" TextBlock.LineHeight="19" VerticalContentAlignment="Center" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="#26344A" CaretBrush="#5B6CEB" Background="Transparent" BorderThickness="0" PreviewKeyDown="QuickPromptKeyDown"/><TextBlock x:Name="QuickPromptHint" Text="询问当前屏幕，或连续圈选多个区域…" Foreground="#8B99AD" Margin="9,0,0,0" FontSize="13" LineHeight="19" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Grid>
     </Border>
     <Button x:Name="VoiceButton" Grid.Column="1" VerticalAlignment="Bottom" ToolTip="语音输入" Click="QuickVoice" Style="{StaticResource RoundIconButton}"><Path x:Name="VoiceIcon" Width="16" Height="18" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 M17.3,11 C17.3,14 14.76,16.1 12,16.1 C9.24,16.1 6.7,14 6.7,11 L5,11 C5,14.41 7.72,17.23 11,17.72 L11,21 L13,21 L13,17.72 C16.28,17.23 19,14.41 19,11 Z"/></Button>
     <Button x:Name="SendButton" Grid.Column="2" VerticalAlignment="Bottom" ToolTip="发送" Click="QuickSend" Style="{StaticResource SendRoundButton}"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M2,3 L22,12 L2,21 L2,14 L16,12 L2,10 Z"/></Button>
    </Grid>
    <TextBlock x:Name="PromptStatus" Grid.Row="6" Text="拖动可连续框选多个区域 · Enter 发送 · Shift+Enter 换行" Foreground="#8B98AA" FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
   </Grid>
  </Border>
  <TextBlock x:Name="SizeText" Visibility="Collapsed" Foreground="White" Background="#CC111722" Padding="6,3"/>
 </Canvas>
</Window>
