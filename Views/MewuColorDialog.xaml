<Window x:Class="mewu_ai_Assistant.Views.MewuColorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="选择标注颜色" Width="410" Height="390" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="False" Background="#F9FBFE" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft YaHei UI" Foreground="#334259">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Width" Value="58"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Background" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#D9E2EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#687AF0"/><Setter TargetName="Box" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="6" Background="#E3E9F2" CornerRadius="3" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFFFFF" Stroke="#687AF0" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ColorButton" TargetType="Button"><Setter Property="MinWidth" Value="94"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Foreground" Value="#4A5A72"/><Setter Property="Background" Value="#F0F4F9"/><Setter Property="BorderBrush" Value="#D9E2EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E7EDF6"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ColorPrimaryButton" TargetType="Button" BasedOn="{StaticResource ColorButton}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#6173ED"/><Setter Property="BorderBrush" Value="#6173ED"/></Style>
 </Window.Resources>
 <Border Background="#F9FBFE" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="16">
  <Grid Margin="20,0,20,18"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="-4,0,-10,0" MouseLeftButtonDown="TitleMouseDown"><TextBlock Text="选择标注颜色" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/><Button Width="32" Height="32" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CancelClick"><TextBlock Text="×" FontSize="20" Foreground="#75839A"/></Button></Grid>
   <Border Grid.Row="1" Background="White" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="13" Padding="10"><Grid><Border x:Name="ColorPreview" CornerRadius="8" Background="#E14959"/><TextBlock x:Name="HexPreview" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="White"/></Grid></Border>
   <Grid Grid.Row="2" Margin="4,10"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center" Foreground="#D94B58" FontWeight="Bold"/><Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="SliderChanged"/><TextBox x:Name="RedValue" Grid.Row="0" Grid.Column="2" TextChanged="ValueTextChanged"/>
    <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Foreground="#2E9B6F" FontWeight="Bold"/><Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="SliderChanged"/><TextBox x:Name="GreenValue" Grid.Row="1" Grid.Column="2" TextChanged="ValueTextChanged"/>
    <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Foreground="#397FE3" FontWeight="Bold"/><Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="SliderChanged"/><TextBox x:Name="BlueValue" Grid.Row="2" Grid.Column="2" TextChanged="ValueTextChanged"/>
   </Grid>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="取消" Style="{StaticResource ColorButton}" Click="CancelClick"/><Button Content="使用此颜色" IsDefault="True" Style="{StaticResource ColorPrimaryButton}" Click="ConfirmClick"/></StackPanel>
  </Grid>
 </Border>
</Window>
