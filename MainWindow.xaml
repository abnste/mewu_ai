<Window x:Class="mewu_ai_Assistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="喵呜AI" Height="290" Width="680" MinHeight="280" MinWidth="620" SizeToContent="Manual" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource PrimaryText}" Closing="OnClosing">
 <Border Background="{StaticResource WindowBackground}" BorderBrush="#D8E0EC" BorderThickness="1" CornerRadius="15" TextElement.Foreground="{StaticResource PrimaryText}" MouseLeftButtonDown="DragWindow">
  <Border.Effect><DropShadowEffect Color="#66758C" BlurRadius="26" ShadowDepth="8" Opacity=".25"/></Border.Effect>
  <Grid ClipToBounds="True">
   <Rectangle Fill="{StaticResource WindowGlow}" IsHitTestVisible="False"/>
   <Grid Margin="22,14,22,16">
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="12"/><RowDefinition Height="98"/><RowDefinition Height="10"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <Grid>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/MewuAI.Icon.png" Width="27" Height="27"/><TextBlock Text="喵呜AI" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Style="{StaticResource IconButton}" Padding="11,4" Click="MinimizeWindow"/><Button Content="×" Style="{StaticResource IconButton}" Padding="11,4" Margin="6,0,0,0" Click="HideWindow"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Click="StartCapture" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="17">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="38" Height="38" CornerRadius="10" Background="#E5F6FD"><TextBlock Text="⌖" FontSize="21" Foreground="#1689E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="屏幕助手" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="圈选并直接分析" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
       <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </Grid>
     </Button>
     <Button Grid.Column="2" Click="OpenTextAi" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="17">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="38" Height="38" CornerRadius="10" Background="#EEEAFE"><TextBlock Text="✦" FontSize="18" Foreground="#6157E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="快速提问" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="不截取屏幕" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
       <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </Grid>
    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="16,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Ellipse Width="8" Height="8" Fill="#35C98A" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center"><TextBlock Text="本地功能可用" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ProviderText" Text="AI Provider 未配置" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
      <Button Grid.Column="2" Content="设置" Click="OpenSettings" Style="{StaticResource SecondaryButton}" Padding="18,8"/>
     </Grid>
    </Border>
    <TextBlock x:Name="HotkeyText" Text="Ctrl + Shift + A" Visibility="Collapsed"/>
   </Grid>
  </Grid>
 </Border>
</Window>
