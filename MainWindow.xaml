<Window x:Class="mewu_ai_Assistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="喵呜AI" Height="520" Width="780" MinHeight="480" MinWidth="720" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}" Closing="OnClosing">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="喵呜AI" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="看懂屏幕，也不打扰你的工作。" Margin="0,8,0,0" Foreground="{StaticResource SecondaryText}" FontSize="15"/></StackPanel>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#43D17A" VerticalAlignment="Center"/><TextBlock Text="就绪" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
   <Grid Grid.Row="1" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="屏幕快捷键" Foreground="{StaticResource SecondaryText}"/><TextBlock x:Name="HotkeyText" Text="Ctrl + Shift + A" FontSize="20" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="AI 模型" Foreground="{StaticResource SecondaryText}"/><TextBlock x:Name="ProviderText" Text="尚未配置（基础功能可用）" FontSize="16" Margin="0,10,0,0"/></StackPanel>
   </Grid>
   <TextBlock Grid.Row="2" Margin="0,28,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Text="截图、贴图、标注、复制和保存均可离线使用。只有你明确点击 AI 或翻译发送后，屏幕内容才会上传到所选模型。"/>
  </Grid></Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="设置" Click="OpenSettings" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/><Button Content="开始屏幕 AI" Click="StartCapture" Style="{StaticResource PrimaryButton}"/></StackPanel>
 </Grid>
</Window>
